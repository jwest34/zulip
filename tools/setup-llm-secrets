#!/usr/bin/env bash
# Configure the LLM provider for the Zulip dev server.
# Writes zproject/dev-secrets.conf (git-ignored). Run from the repo root:
#   ./tools/setup-llm-secrets
# Defaults target Groq's free tier. Override model/base for another
# OpenAI-compatible provider, e.g.:
#   LLM_MODEL=gpt-4o-mini LLM_API_BASE=https://api.openai.com/v1 ./tools/setup-llm-secrets
set -euo pipefail

cd "$(dirname "$0")/.."
CONF=zproject/dev-secrets.conf
MODEL="${LLM_MODEL:-openai/gpt-oss-120b}"
BASE="${LLM_API_BASE:-https://api.groq.com/openai/v1}"

read -r -s -p "Paste API key (input hidden): " KEY; echo
[[ -n "$KEY" ]] || { echo "No key entered; nothing written." >&2; exit 1; }

# Preserve any other secrets already in the file; replace our three lines.
if [[ -f "$CONF" ]]; then
  grep -v -E '^(topic_summarization_api_key|topic_summarization_model|topic_summarization_api_base)\s*=' "$CONF" > "$CONF.tmp" || true
else
  printf '[secrets]\n' > "$CONF.tmp"
fi
grep -q '^\[secrets\]' "$CONF.tmp" || sed -i '1i [secrets]' "$CONF.tmp"
{
  echo "topic_summarization_api_key = $KEY"
  echo "topic_summarization_model = $MODEL"
  echo "topic_summarization_api_base = $BASE"
} >> "$CONF.tmp"
mv "$CONF.tmp" "$CONF"
chmod 600 "$CONF"

git check-ignore -q "$CONF" && echo "Wrote $CONF (git-ignored). model=$MODEL base=$BASE" \
  || { echo "WARNING: $CONF is NOT git-ignored — do not commit it." >&2; exit 2; }
echo "Restart the dev server for settings to take effect."
